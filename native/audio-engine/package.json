{
  "name": "audio-engine",
  "version": "0.1.0",
  "main": "audio-engine.node",
  "types": "index.d.ts",
  "napi": {
    "binaryName": "audio-engine",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu"
    ]
  },
  "scripts": {
    "build": "napi build --release --no-const-enum",
    "build:debug": "napi build --no-const-enum",
    "test:integration": "node --test --test-concurrency=1 tests/*.cjs"
  },
  "os": [
    "linux"
  ],
  "cpu": [
    "x64",
    "arm64"
  ]
}
